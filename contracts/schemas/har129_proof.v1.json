{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/contracts/har129_proof.v1.json",
  "title": "Har129ProofManifest",
  "description": "artifacts/har129/<run_id>/manifest.json: the machine-readable index of one HAR-129 proof run (HAR-129 section H). It names the 13 required artifact files, the summary counts, and one confirmation-matrix row per HAR-129 visible/product requirement (section I). A local unit test, a schema existing, a mock/fake-core run, a screenshot, hard-coded UI state or code inspection alone can never set a row to CONFIRMED (section I.4); only observed live behavior with machine evidence can.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "generated_at", "contract", "command", "status",
    "requirement_source", "summary", "artifacts", "matrix"
  ],
  "properties": {
    "run_id": {
      "description": "Run directory name under artifacts/har129/.",
      "type": "string",
      "pattern": "^har129-[A-Za-z0-9._-]+$"
    },
    "generated_at": { "$ref": "common.v1.json#/$defs/timestamp" },
    "contract": { "const": "HAR-129" },
    "command": {
      "description": "The exact documented command that produced this run.",
      "type": "string",
      "minLength": 1
    },
    "status": { "$ref": "#/$defs/status" },
    "requirement_source": {
      "description": "The requirement source of truth this matrix was generated from (HAR-129 section I: generated from one list, not hand-written).",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "requirements_total", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "requirements_total": { "type": "integer", "minimum": 1 },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the source file bytes, so the matrix can be tied to an exact revision.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "partial", "not_confirmed", "failed", "not_run", "total"],
      "properties": {
        "confirmed": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "not_confirmed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "artifacts": {
      "description": "Exactly the 13 files HAR-129 section H requires, in that order.",
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "matrix": {
      "description": "One row per requirement in the requirement source of truth, no omissions.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "status": {
      "description": "Lowercase form of the HAR-129 section I.4 status vocabulary.",
      "enum": ["confirmed", "partial", "not_confirmed", "failed", "not_run"]
    },
    "artifactId": {
      "enum": [
        "manifest.json",
        "environment.json",
        "episode_timeline.json",
        "state_snapshots.json",
        "graph_diffs.json",
        "decision_episodes.json",
        "eval_bundles.json",
        "human_judgments.json",
        "customer_reactions.json",
        "knowledge_history.json",
        "abc_report.json",
        "e2e-results.json",
        "demo-report.md"
      ]
    },
    "requirementId": {
      "type": "string",
      "pattern": "^HAR129-[A-Z0-9]+-[0-9]{2}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "present", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/artifactId" },
        "path": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirementId" },
          "uniqueItems": true
        }
      }
    },
    "row": {
      "description": "One confirmation-matrix row (HAR-129 section I.1-I.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id", "section", "requirement", "required_behavior",
        "observed_live_behavior", "evidence", "status", "gap"
      ],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/requirementId" },
        "section": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "required_behavior": { "type": "string", "minLength": 1 },
        "observed_live_behavior": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "status": { "$ref": "#/$defs/status" },
        "gap": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "evidence": { "minItems": 1 },
              "gap": { "maxLength": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["partial", "not_confirmed", "failed", "not_run"] } },
            "required": ["status"]
          },
          "then": { "properties": { "gap": { "minLength": 1 } } }
        }
      ]
    }
  }
}

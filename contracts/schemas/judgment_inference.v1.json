{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/contracts/judgment_inference.v1.json",
  "title": "JudgmentInference",
  "description": "Slack Message 3 (HAR-129 section 11, 12): Ghost's inference of why the human chose what they chose, and the human's verdict on that inference. The verdict and note are higher-quality supervision than the click alone. One human choice never becomes company knowledge directly: this record only feeds a candidate criterion that must be scoped and backtested.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "decision_episode_id", "human_strategy_decision_id", "agent_preference", "human_choice", "agreement",
    "inferred_semantic_delta", "evidence", "human_verdict", "generated_at"
  ],
  "properties": {
    "id": { "$ref": "common.v1.json#/$defs/uuid" },
    "decision_episode_id": { "$ref": "common.v1.json#/$defs/uuid" },
    "human_strategy_decision_id": { "$ref": "common.v1.json#/$defs/uuid" },
    "agent_preference": { "description": "Candidate Ghost ranked first.", "$ref": "common.v1.json#/$defs/uuid" },
    "human_choice": { "description": "Candidate the human selected.", "$ref": "common.v1.json#/$defs/uuid" },
    "agreement": {
      "description": "agreed when the human chose Ghost's preference (the judgment is confirmed rather than contradicted), overrode otherwise; a SQL CHECK ties it to the two ids.",
      "type": "string",
      "enum": ["agreed", "overrode"]
    },
    "inferred_semantic_delta": {
      "description": "What the human valued differently from Ghost, in words, plus labels from the HumanDelta vocabulary where they fit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "semantic_labels": { "$ref": "human_delta.v1.json#/properties/semantic_labels" }
      }
    },
    "evidence": {
      "description": "Why Ghost inferred this (Message 3 'Why Ghost inferred this').",
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_differences", "evidence_refs", "eval_differences", "knowledge_refs", "no_applicable_knowledge"],
      "properties": {
        "candidate_differences": {
          "description": "How the preferred and the chosen candidate differ.",
          "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "evidence_refs": {
          "description": "Account-state evidence behind the inference.",
          "type": "array", "minItems": 1, "items": { "$ref": "common.v1.json#/$defs/evidenceRef" }
        },
        "eval_differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eval_type", "agent_preference_verdict", "human_choice_verdict"],
            "properties": {
              "eval_type": { "$ref": "eval_result.v1.json#/$defs/evalType" },
              "agent_preference_verdict": { "$ref": "eval_bundle.v1.json#/$defs/item/properties/verdict" },
              "human_choice_verdict": { "$ref": "eval_bundle.v1.json#/$defs/item/properties/verdict" },
              "note": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        },
        "knowledge_refs": { "type": "array", "items": { "$ref": "common.v1.json#/$defs/uuid" } },
        "no_applicable_knowledge": {
          "description": "True when no company knowledge applied; the absence is part of the evidence.",
          "type": "boolean"
        }
      }
    },
    "human_verdict": { "type": "string", "enum": ["pending", "confirmed", "corrected"] },
    "corrected_statement": {
      "description": "The human's replacement for inferred_semantic_delta.statement.",
      "type": ["string", "null"], "maxLength": 1500
    },
    "human_note": { "type": ["string", "null"], "maxLength": 2000 },
    "verdict_surface": { "oneOf": [{ "$ref": "human_decision.v1.json#/properties/surface" }, { "type": "null" }] },
    "verdict_actor_label": { "type": ["string", "null"], "maxLength": 200 },
    "verdict_at": { "oneOf": [{ "$ref": "common.v1.json#/$defs/timestamp" }, { "type": "null" }] },
    "model": { "type": ["string", "null"] },
    "generated_at": { "$ref": "common.v1.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "description": "Confirmed or corrected verdicts are dated and attributed.",
      "if": { "properties": { "human_verdict": { "enum": ["confirmed", "corrected"] } } },
      "then": {
        "required": ["verdict_at", "verdict_surface"],
        "properties": {
          "verdict_at": { "$ref": "common.v1.json#/$defs/timestamp" },
          "verdict_surface": { "$ref": "human_decision.v1.json#/properties/surface" }
        }
      }
    },
    {
      "description": "A correction carries the human's corrected explanation.",
      "if": { "properties": { "human_verdict": { "const": "corrected" } } },
      "then": {
        "required": ["corrected_statement"],
        "properties": { "corrected_statement": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "description": "Nothing is corrected or dated before the human has answered.",
      "if": { "properties": { "human_verdict": { "const": "pending" } } },
      "then": { "properties": { "corrected_statement": { "type": "null" }, "verdict_at": { "type": "null" } } }
    },
    {
      "description": "A confirmed inference has nothing to correct.",
      "if": { "properties": { "human_verdict": { "const": "confirmed" } } },
      "then": { "properties": { "corrected_statement": { "type": "null" } } }
    }
  ]
}

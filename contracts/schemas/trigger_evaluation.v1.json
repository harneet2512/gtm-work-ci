{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/contracts/trigger_evaluation.v1.json",
  "title": "TriggerEvaluation",
  "description": "Workflow eligibility decision. Persisted for both eligible and ineligible outcomes. HAR-96 decides eligibility only; HAR-97 judges whether the proposed action is good.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "account_id", "workflow", "eligible", "reason_codes", "signal_ids", "evaluated_at"],
  "properties": {
    "id": { "$ref": "common.v1.json#/$defs/uuid" },
    "account_id": { "$ref": "common.v1.json#/$defs/uuid" },
    "workflow": { "type": "string", "enum": ["post_interaction_followup"] },
    "eligible": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "eligible_customer_replied", "eligible_meeting_completed", "eligible_stakeholder_change",
          "eligible_blocker_change", "no_material_change", "no_relevant_signal", "open_run_exists",
          "rep_already_replied", "cooldown", "champion_unknown", "permission_denied", "account_unresolved"
        ]
      }
    },
    "explanation": { "type": "string", "maxLength": 1000 },
    "signal_ids": { "type": "array", "items": { "$ref": "common.v1.json#/$defs/uuid" } },
    "state_diff_id": { "oneOf": [{ "$ref": "common.v1.json#/$defs/uuid" }, { "type": "null" }] },
    "agent_run_id": { "oneOf": [{ "$ref": "common.v1.json#/$defs/uuid" }, { "type": "null" }] },
    "evaluated_at": { "$ref": "common.v1.json#/$defs/timestamp" }
  },
  "if": { "properties": { "eligible": { "const": false } } },
  "then": {
    "properties": {
      "agent_run_id": { "type": "null" },
      "reason_codes": { "items": { "not": { "pattern": "^eligible_" } } }
    }
  },
  "else": {
    "properties": {
      "reason_codes": { "items": { "pattern": "^eligible_" } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/contracts/completeness_matrix.v1.json",
  "title": "CompletenessMatrix",
  "description": "The 20 surface x 10 dimension completeness matrix (HAR-97 sections 1 and 13, HAR-140 / WP36). Each of the 200 cells is REQUIRED, NOT_APPLICABLE (with a reason) or COVERED_BY (eval ids). A REQUIRED cell must be status planned with an owning Linear issue. The construction gate (bench/metrics/completeness_gate.py) additionally checks the cells against contracts/evals/eval_registry.json. The instance is contracts/evals/completeness_matrix.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_version", "description", "source", "surfaces", "dimensions", "cells"],
  "properties": {
    "matrix_version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "section", "fetched_on"],
      "properties": {
        "issue": {"const": "HAR-97"},
        "section": {"type": "string"},
        "fetched_on": {"type": "string", "format": "date"}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 20}, "name": {"type": "string", "minLength": 1}}
      }
    },
    "dimensions": {
      "const": ["INTENDED_BEHAVIOR", "INVARIANTS", "BOUNDARIES", "FAILURE_MODES", "AMBIGUITY_ABSTENTION", "ADVERSARIAL_GAMING", "STOCHASTIC_RELIABILITY", "CAUSAL_TRACE_ATTRIBUTION", "REGRESSION_RISK", "OBSERVABILITY"]
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["surface", "dimension", "state"],
      "oneOf": [{"properties": {"surface": {"type": "integer", "minimum": 1, "maximum": 20}, "dimension": {"enum": ["INTENDED_BEHAVIOR", "INVARIANTS", "BOUNDARIES", "FAILURE_MODES", "AMBIGUITY_ABSTENTION", "ADVERSARIAL_GAMING", "STOCHASTIC_RELIABILITY", "CAUSAL_TRACE_ATTRIBUTION", "REGRESSION_RISK", "OBSERVABILITY"]}, "state": {"const": "COVERED_BY"}, "evals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(E(?:[1-9]|1[0-9]|2[0-2])(?:\\.[0-9]+)?|M[1-5])$"}}}, "required": ["evals"], "additionalProperties": false}, {"properties": {"surface": {"type": "integer", "minimum": 1, "maximum": 20}, "dimension": {"enum": ["INTENDED_BEHAVIOR", "INVARIANTS", "BOUNDARIES", "FAILURE_MODES", "AMBIGUITY_ABSTENTION", "ADVERSARIAL_GAMING", "STOCHASTIC_RELIABILITY", "CAUSAL_TRACE_ATTRIBUTION", "REGRESSION_RISK", "OBSERVABILITY"]}, "state": {"const": "NOT_APPLICABLE"}, "reason": {"type": "string", "minLength": 20}}, "required": ["reason"], "additionalProperties": false}, {"properties": {"surface": {"type": "integer", "minimum": 1, "maximum": 20}, "dimension": {"enum": ["INTENDED_BEHAVIOR", "INVARIANTS", "BOUNDARIES", "FAILURE_MODES", "AMBIGUITY_ABSTENTION", "ADVERSARIAL_GAMING", "STOCHASTIC_RELIABILITY", "CAUSAL_TRACE_ATTRIBUTION", "REGRESSION_RISK", "OBSERVABILITY"]}, "state": {"const": "REQUIRED"}, "status": {"const": "planned"}, "owner": {"type": "string", "pattern": "^HAR-[0-9]+$"}, "evals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(E(?:[1-9]|1[0-9]|2[0-2])(?:\\.[0-9]+)?|M[1-5])$"}}, "note": {"type": "string", "minLength": 1}}, "required": ["status", "owner", "evals"], "additionalProperties": false}]
    }
  }
}

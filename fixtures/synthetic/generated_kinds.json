  "payload": {
   "body_text": "Hi Liam,\n\nI wanted to give you a heads-up that NaviCorp Tech is going through a restructure this quarter. Several teams are being combined, and some responsibilities, including ownership of the work we have been discussing on Advanced Navigation Optimization Project, are being reassigned.\n\nOnce the new structure is confirmed I will let you know who your main contact will be. Until then, please bear with us if responses take a little longer than usual.\n\nBest,\n\nNikhil Reddy\nNaviCorp Tech",
   "crm_opportunity_ref": "opp:006Wt000007BFEFIA4",
   "date": "2021-06-17T16:15:00Z",
   "direction": "inbound",
   "from": {
    "email": "nikhil.reddy@navicorptech.com",
    "name": "Nikhil Reddy"
   },
   "in_reply_to": null,
   "kind": "email",
   "message_id": "02sWt00000209TlIAI",
   "subject": "Organisational changes at NaviCorp Tech",
   "thread_id": "opp:006Wt000007BFEFIA4",
   "to": [
    {
     "email": "liam.osullivan@ghostvendor.com",
     "name": "Liam O'Sullivan"
    }
   ]
  },
  "provenance": "synthetic:v1",
  "source_event_key": "received",
  "source_object_id": "02sWt00000209TlIAI",
  "source_system": "email"
 },

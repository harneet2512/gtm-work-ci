# Postgres — Neon connection string (dev/demo). CI uses its own service container.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional: separate database for integration tests. When unset, Go tests start an
# on-demand embedded Postgres instead (no Docker needed).
TEST_DATABASE_URL=

# Core service
CORE_ADDR=127.0.0.1:8080
WORKER_URL=http://127.0.0.1:8090
# Worker -> core base URL (the worker never accepts a core URL from requests)
CORE_URL=http://127.0.0.1:8080
# Bearer token for the web UI / operator API (generate: openssl rand -hex 32)
GHOST_API_TOKEN=
# Web control plane: the demo manifest id (a uuid) /control, /replay and /system open on, so nobody types it.
# The core serves no manifest list, so this is configuration. Leave empty to be asked for the id.
GHOST_DEMO_MANIFEST_ID=
# Signing secret for run-scoped context tokens (>= 32 random chars; generate: openssl rand -hex 32).
# REQUIRED when GHOST_RUN_MODE=live. When empty (dry_run only) the key is derived from GHOST_API_TOKEN,
# and rotating the API token then invalidates every in-flight run token (an in-progress draft gets 401).
GHOST_RUN_TOKEN_SECRET=
# Coalescing window for state recompute (milliseconds)
COALESCE_DEBOUNCE_MS=3000
COALESCE_MAX_WAIT_MS=15000
# Transition rule set (ADR-0012). Empty turns the transition detector off (relationship state stays "unknown").
GHOST_TRANSITION_RULES=contracts/transitions/rules.v1.json
# Replay dataset for the demo's Play (HAR-124): a SourceEvent JSON file or a directory of them. The held-out event
# lives only here until Play releases it. Empty: POST /replay/play answers 503 replay_source_unavailable.
GHOST_REPLAY_EVENTS=
# The episode replay's historical/live split (HAR-129): episodes 1..N-1 are the historical-learning window and
# the held-out event N is live. Empty means "all of history" (h = N-1); set h < N-1 to also replay live steps.
GHOST_REPLAY_HISTORICAL_END=
# Knowledge lifecycle rules the episode view's knowledge-as-of read replays (HAR-117/HAR-129) and the
# HAR-120 supervision service grades reaction/outcome evidence against. Empty: the replay endpoint answers
# 503 knowledge_unavailable, supervision scanning stays off and /episodes/{id}/reactions is not served.
GHOST_KNOWLEDGE_RULES=contracts/knowledge/lifecycle.v1.json
# How long after a send a customer_silence tick must arrive before it records an `ignored` customer
# reaction (HAR-120). Milliseconds; 0/empty selects the detector default of 7 days.
SUPERVISION_SILENCE_MS=
# A claimed recompute job is held for this long (default 300000 = 5 min). The lease is renewed before every
# model call (HAR-135), so it only has to cover ONE worker call: it may not be shorter than WORKER_TIMEOUT_MS
# or core refuses to start.
COALESCE_LEASE_MS=
# Core's per-call timeout to the worker's /v1/extract. Default: the worker's deadline (EXTRACT_DEADLINE_S below,
# which core reads too) plus 30 s. Core refuses to start when it is not larger than that deadline.
WORKER_TIMEOUT_MS=210000

# Provider circuit breaker (HAR-135). A 401/402/403 (or "insufficient credits", "quota", "auth") from the model
# provider is non-retryable: the worker answers 424 provider_unavailable_nonretryable and core parks the job
# without retrying. After this many consecutive provider failures (non-retryable, unreachable worker, 5xx) core
# pauses ALL model calls (no job is claimed) and logs one "circuit breaker OPEN" line. It reopens after the
# cool-down (one probe call) or at once with `ghostctl breaker reset` (status: `ghostctl breaker`). The worker reads
# the same two variables for its own breaker (it refuses calls locally with 424 while open).
PROVIDER_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_COOLDOWN_S=300
# Ceiling on core's model-worker calls per minute, shared by the orchestrator's /v1/strategies, /v1/judge and
# /v1/revise calls (a token bucket in front of the worker guard). Empty or 0 = unlimited. Set it to the provider
# key's own ceiling (TokenRouter currently 5/min) so a run does not spend its retry budget racing a limit core
# cannot see. The worker paces itself separately through GHOST_LLM_MAX_RPM.
GHOST_PROVIDER_RPM=5

# Model worker (Python) — OpenRouter via litellm
OPENROUTER_API_KEY=
GHOST_MODEL=openrouter/deepseek/deepseek-v4-flash
GHOST_FALLBACK_MODEL=openrouter/dots-studio/dots-3-note-preview:free
# record | replay | live  (replay uses cassettes, no network)
GHOST_LLM_MODE=live
# Overall provider deadline (seconds, <= 900): interactive /v1/draft calls, and /v1/extract, which is
# asynchronous graph maintenance and gets a longer budget for long call transcripts.
LLM_DEADLINE_S=90
EXTRACT_DEADLINE_S=180
# Semantic judges (offline evaluation, long structured answers).
JUDGE_DEADLINE_S=180
# Process-wide request pacing (requests per minute), shared by extract, judge and draft calls. Empty = unlimited.
# OpenRouter `:free` models allow about 20/min and throttle upstream: use 15 for them.
GHOST_LLM_MAX_RPM=
# Consecutive 429s on the primary model (each retried after Retry-After, else exponential backoff with jitter)
# before the fallback model is used. The OpenRouter free-models-per-day cap is not retried: it opens the
# provider breaker until 00:00 UTC.
LLM_RATE_LIMIT_SWITCH_AFTER=3

# Run orchestrator (HAR-117): a bounded background worker inside core takes every AgentRun the trigger pipeline
# opens to a published StrategySet (knowledge -> guidance -> 3 candidates -> evals -> one revision -> rank -> publish),
# never in a request path. It also resumes runs left open by an earlier process at startup, and does nothing
# while the provider breaker is open (the run stays resumable). Needs WORKER_URL. dry_run runs only.
# This file is the demo configuration, so it is on here; the code default (and every test) is off.
# Run it in exactly ONE core instance: startup treats every running draft step as abandoned by a dead process.
GHOST_ORCHESTRATOR=on
# Which open runs the driver takes. play (code default, and the demo's): only the run of a Play (its trigger activity is
# a demo_plays.activity_id) plus runs whose draft step already has an attempt (so a crash resumes). The historical open run
# that a `ghostctl crmarena` import leaves for every account is never driven: it would cost 4+ model calls on a 5 req/min key
# and post a Message 2 with no Message 1. all: drive every open dry-run run.
GHOST_ORCHESTRATOR_SCOPE=play
# Runs driven at once, always for different accounts (an account has one open run). Default 1.
GHOST_ORCHESTRATOR_CONCURRENCY=1
# How often the driver looks for open runs (milliseconds, default 2000) and how long a run that failed
# transiently waits before it is resumed (seconds, default 30).
GHOST_ORCHESTRATOR_POLL_MS=2000
GHOST_ORCHESTRATOR_RETRY_S=30
# How many times one run may be handed to the orchestrator before the driver gives up and fails it permanently
# (default 5). Every transient failure is deliberately resumable, so this caps a provider that keeps refusing.
GHOST_ORCHESTRATOR_MAX_ATTEMPTS=5
# Workspace the deterministic evals' policy applies to, and the two rule files (paths relative to the working
# directory, which is the repository root).
GHOST_WORKSPACE_ID=ghost-demo
GHOST_TRANSITION_ROUTING=contracts/transitions/routing.v1.json

# Safety: external writes (email send, CRM write) are impossible unless BOTH are set.
GHOST_RUN_MODE=dry_run
GHOST_ALLOW_EXTERNAL_WRITES=false

# Slack surface (HAR-112/HAR-123), Socket Mode; see docs/slack-setup.md. Live mode refuses to start if any
# SLACK_* value is empty. Never commit real values. `slackbot --dry-run` needs none of them.
# App-level token (xapp-..., scope connections:write)
SLACK_APP_TOKEN=
# Bot user OAuth token (xoxb-...)
SLACK_BOT_TOKEN=

# Neo4j context-graph projection (optional; empty NEO4J_URI disables it). Postgres stays authoritative.
# Local dev: any Neo4j 5.26 you run yourself. Tests do NOT use these: they use NEO4J_TEST_* or a local tarball.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Graph tests (go test ./internal/ctxgraph/...). With NEO4J_TEST_URI set (CI service container) that server is used and WIPED:
# it must be loopback and differ from NEO4J_URI. With it unset, a pinned Neo4j Community tarball is downloaded to
# GHOST_NEO4J_CACHE (default <repo>/.neo4j-cache, git-ignored), checksum-verified and run as a Java 17/21 process; no Java => the
# graph tests skip with a message. GHOST_REQUIRE_NEO4J=1 turns a skip into a failure.
NEO4J_TEST_URI=
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=
# NEO4J_TEST_AUTH=none for a throwaway server started with auth disabled (the CI service container).
NEO4J_TEST_AUTH=
GHOST_NEO4J_CACHE=
GHOST_REQUIRE_NEO4J=

# The listener reacts to core's strategy_set.published outbox events and posts Message 2 with the real set
# (GET /outbox/events, acknowledged after the post). SLACK_OUTBOX=off disables that (then Message 2 only goes out
# through `slackbot --post-run`; do not use both for one run, they share no state and would post twice).
SLACK_OUTBOX=
# How often the listener asks core for new events (milliseconds, default 2000).
SLACK_OUTBOX_POLL_MS=

# Demo channel id (C...); invite the bot to it first
SLACK_CHANNEL_ID=
# Required by the listener: comma-separated Slack member ids (U...) allowed to press Choose/Send/Edit.
SLACK_ALLOWED_USER_IDS=
# Set to exactly 1 to run the listener without an allowlist (any channel member can then send).
SLACK_ALLOW_ALL_USERS=
# Optional: comma-separated Slack member ids (U...) allowed to ASK Cliff (DM or @mention) and press its Run button.
# Unset: whoever can reach the bot may ask (read only; a state-changing step still needs its own confirmation).
GHOST_ASK_ALLOWED_USERS=
# Optional: web UI base URL for the "View account map" button.
GHOST_WEB_URL=
# Optional: the replay manifest of the demo; Message 1 View trace opens /episodes/{id}?manifest={id}.
GHOST_DEMO_MANIFEST_ID=

# Demo Start mode (scripts/demo/start-demo.ps1): restore (default) puts both cases back at Event N-1 from the sealed baseline;
# resume keeps the live state. The Reset shortcut always restores, whatever this says.
# GHOST_DEMO_START=restore
